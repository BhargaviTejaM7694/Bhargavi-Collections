# Composio (email via Gmail)
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_CONNECTED_ACCOUNT_ID=your_connected_account_id
COMPOSIO_USER_ID=your_composio_user_id

# Admin credentials (required — no fallback defaults)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_password_here

# Session secret for signing admin cookies (optional — falls back to ADMIN_PASSWORD)
SESSION_SECRET=random_64_char_hex_string

# Order recipient email
ORDER_RECIPIENT_EMAIL=your_email@gmail.com
